# Copy to .env for local runs. Placeholder values only — never commit real secrets.

# HTTP port the API listens on. This service deliberately uses API_PORT (not PORT) so it cannot
# collide with a web frontend's PORT in the same environment.
API_PORT=4123

# development | test | production. PII_HASH_KEY is required for any non-development environment.
NODE_ENV=development

# Pino log level: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info

# HMAC key used to hash rate-limit/quota subjects (e.g. client IPs). Never log the key itself.
# Rotating this key invalidates historical subject hashes, so old hashes cannot be joined with new
# ones after rotation — choose a long random value and rotate via a documented process.
PII_HASH_KEY=dev-only-change-me

# Expose Prometheus-style GET /metrics. The endpoint has no application-level auth; expose it only
# through Render private networking or an IP allowlist.
METRICS_ENABLED=true
